{
  "info": {
    "name": "Assessment Platform API",
    "description": "Postman collection for authentication and question creator endpoints. Login first; Postman stores the JWT cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "question_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "qp_number",
      "value": "1",
      "type": "string"
    },
    {
      "key": "assessment_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "POST /api/auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "POST /api/auth/login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "GET /api/auth/me",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "POST /api/auth/logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      }
    },
    {
        "name": "POST /api/questions",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"questionText\": \"Which HTTP method is typically used to create a resource?\",\n  \"type\": \"single-choice\",\n  \"difficulty\": \"easy\",\n  \"status\": \"draft\",\n  \"points\": 1,\n  \"additionalInfo\": {\n    \"options\": [\"GET\", \"POST\", \"DELETE\"],\n    \"correctAnswers\": [1]\n  }\n}"
          },
          "url": {
            "raw": "{{base_url}}/api/questions",
            "host": ["{{base_url}}"],
            "path": ["api", "questions"]
          }
        }
      },
      {
        "name": "GET /api/questions",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{base_url}}/api/questions?search=HTTP&status=draft&type=single-choice&page=1&limit=20",
            "host": ["{{base_url}}"],
            "path": ["api", "questions"],
            "query": [
              { "key": "search", "value": "HTTP" },
              { "key": "status", "value": "draft" },
              { "key": "type", "value": "single-choice" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" }
            ]
          }
        }
      },
      {
        "name": "GET /api/questions/:id",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{base_url}}/api/questions/{{question_id}}",
            "host": ["{{base_url}}"],
            "path": ["api", "questions", "{{question_id}}"]
          }
        }
      },
      {
        "name": "PATCH /api/questions/:id",
        "request": {
          "method": "PATCH",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"status\": \"published\",\n  \"points\": 2\n}"
          },
          "url": {
            "raw": "{{base_url}}/api/questions/{{question_id}}",
            "host": ["{{base_url}}"],
            "path": ["api", "questions", "{{question_id}}"]
          }
        }
      },
      {
        "name": "DELETE /api/questions/:id",
        "request": {
          "method": "DELETE",
          "url": {
            "raw": "{{base_url}}/api/questions/{{question_id}}",
            "host": ["{{base_url}}"],
            "path": ["api", "questions", "{{question_id}}"]
          }
        }
      },
      {
        "name": "POST /api/assessments",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"title\": \"JavaScript fundamentals\",\n  \"questionIds\": [\"{{question_id}}\"]\n}"
          },
          "url": {
            "raw": "{{base_url}}/api/assessments",
            "host": ["{{base_url}}"],
            "path": ["api", "assessments"]
          }
        }
      },
      {
        "name": "GET /api/assessments",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{base_url}}/api/assessments?search=JavaScript&status=draft&page=1&limit=20",
            "host": ["{{base_url}}"],
            "path": ["api", "assessments"],
            "query": [
              { "key": "search", "value": "JavaScript" },
              { "key": "status", "value": "draft" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" }
            ]
          }
        }
      },
      {
        "name": "GET /api/assessments/:id",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{base_url}}/api/assessments/{{assessment_id}}",
            "host": ["{{base_url}}"],
            "path": ["api", "assessments", "{{assessment_id}}"]
          }
        }
      },
      {
        "name": "PATCH /api/assessments/:id",
        "request": {
          "method": "PATCH",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"status\": \"published\"\n}"
          },
          "url": {
            "raw": "{{base_url}}/api/assessments/{{assessment_id}}",
            "host": ["{{base_url}}"],
            "path": ["api", "assessments", "{{assessment_id}}"]
          }
        }
      },
      {
        "name": "DELETE /api/assessments/:id",
        "request": {
          "method": "DELETE",
          "url": {
            "raw": "{{base_url}}/api/assessments/{{assessment_id}}",
            "host": ["{{base_url}}"],
            "path": ["api", "assessments", "{{assessment_id}}"]
          }
        }
      }
    ]
}
